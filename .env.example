# ─────────────────────────────────────────────
# Argonis — environment variables
# Copy to .env and fill in values
# ─────────────────────────────────────────────

# Supabase (frontend — public keys safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Demo mode — set to 'true' ONLY for landing-page screenshots and recorded
# demo videos. NEVER enable in production or live demos.
# NEXT_PUBLIC_DEMO_MODE=false

# Supabase (backend — keep secret)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# Anthropic (Claude API)
# Required for Step 5 (NARRATE) — pipeline errors without this
ANTHROPIC_API_KEY=sk-ant-...

# OpenSanctions API
# Get key at https://www.opensanctions.org/api/
# Optional — falls back to OFAC-only screening without this
OPENSANCTIONS_API_KEY=

# Serper.dev (Google Search API for adverse media)
# Get key at https://serper.dev
# Optional — adverse media step skipped without this
SERPER_API_KEY=

# API server (FastAPI)
API_URL=http://localhost:8000
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Redis — Optional. Required for multi-instance deployments so rate limit
# counters are shared across uvicorn workers. Falls back to in-memory when
# not set (fine for single-instance / development).
# REDIS_URL=redis://localhost:6379/0
