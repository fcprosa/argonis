# App
ENVIRONMENT=development        # development | staging | production
PORT=8000

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# CORS – JSON array of origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]

# Anthropic (Claude) — used for narrative generation + adverse media summarization
ANTHROPIC_API_KEY=sk-ant-...

# OpenSanctions — covers UN, EU, UK, 40+ lists (free tier available)
OPENSANCTIONS_API_KEY=

# Google Custom Search — adverse media detection ($5/1000 queries)
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
